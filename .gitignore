# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local secrets
.venv/
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/

# Generated data: preserve directory structure, not runtime artifacts
data/raw/**
!data/raw/.gitkeep
data/bronze/**
!data/bronze/.gitkeep
data/silver/**
!data/silver/.gitkeep
data/serving/**
!data/serving/.gitkeep
data/published/**
!data/published/.gitkeep
data/quarantine/**
!data/quarantine/.gitkeep
data/manifests/**
!data/manifests/.gitkeep

# Customer/reference data must never be committed by default
data/reference/**
!data/reference/.gitkeep

# Source PDFs are local inputs. Commit only explicit synthetic fixtures.
data/input/*.pdf
!tests/fixtures/**/*.pdf

# Temporary and generated reports
*.tmp
reports/
logs/

